{
  "name": "time-tracking",
  "version": "0.1.0",
  "description": "Local-first desktop time tracking application",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "author": "TimeTracker",
  "homepage": "https://github.com/local/time-tracking",
  "repository": {
    "type": "git",
    "url": "https://github.com/juliendu11/time-tracking.git"
  },
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "pnpm run build && cross-env SEED=1 electron-vite preview",
    "package:linux": "pnpm run build && electron-builder --linux --publish never",
    "package:win": "pnpm run build && electron-builder --win --publish never",
    "package:mac": "pnpm run build && electron-builder --mac --publish never",
    "package": "pnpm run build && electron-builder --publish never"
  },
  "dependencies": {
    "@lucide/vue": "^1.45.0",
    "better-sqlite3": "^13.0.3",
    "chart.js": "^4.5.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "nanoid": "^6.0.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-chartjs": "^5.3.4",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.5.6",
    "cross-env": "^10.1.0",
    "daisyui": "^5.7.37",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "volta": {
    "node": "24.22.1"
  }
}
